# ---------- Flask / Upstash Redis ----------
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# ---------- Image catalog and CDN ----------
IMAGE_CATALOG_PATH=/secrets/image_catalog.json
IMAGE_CATALOG_HOST_PATH=/opt/spartanguessr/secrets/image_catalog.json
IMAGE_CDN_BASE_URL=https://<your-cdn-bucket>.<region>.digitaloceanspaces.com

# ---------- CORS ----------
ALLOWED_ORIGINS=https://<your-frontend-origin>

# ---------- Redis key isolation ----------
REDIS_KEY_PREFIX=spg:do-exp:<run-id>:

# ---------- Rate limiting (optional, shown with defaults) ----------
# RATE_LIMIT_SECONDS=1
# RATE_LIMIT_REQUESTS=5

# ---------- Caddy ----------
CADDY_HOSTNAME=<your-temporary-hostname>
